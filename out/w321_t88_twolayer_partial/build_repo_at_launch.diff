+# --------------------------------------------------------- W337: the injector
+
+
+def _injector_block(nv: int = 5):
+    """A 6x4 combustor strip: burnt 3000 K products at 8 MPa moving at the
+    declared mass flux, an inlet_massflow face at 900 K on imin, the reaction
+    ON. That pair -- a cold, dense ghost beside the burning gas -- is the
+    rocket combustor's injector face."""
+    from atlas.solvers.compressible2d import ReactionConfig
+    nz, ny = 6, 4
+    z, y = np.linspace(0, 0.06, nz + 1), np.linspace(-0.02, 0.02, ny + 1)
+    Z, Y = np.meshgrid(z, y, indexing="ij")
+    blk = Block("inj", np.stack([Z, Y], -1), np.zeros((nz, ny), bool))
+    gas = GasConfig(gamma=1.22, R=361.0)
+    mdot = 376.87 / 0.08                                  # kg/(s m^2), the rocket's
+    s = Compressible2D(blk, gas, reaction=ReactionConfig(A=1.0e6, T_act=6000.0, q_rxn=3.0e6),
+                       bcs={"imin": BC("inlet_massflow", {"mdot": mdot, "T": 900.0}),
+                            "imax": BC("extrapolate"), "jmin": BC("wall_slip"),
+                            "jmax": BC("wall_slip")})
+    p, T = 8.0e6, 3000.0
+    W = np.zeros((nz, ny, nv))
+    W[..., 0] = p / (gas.R * T)
+    W[..., 1] = mdot / W[..., 0]
+    W[..., 3] = p
+    W[..., 4] = 1.0                                       # burnt
+    return s, thermo.prim_to_cons(W, gas.gamma), mdot
+
+
+def test_W337_the_injector_face_carries_the_declared_flux_with_the_reaction_on():
+    """The face flux is the injection's own: mdot, (mdot u + p) with u from the
+    injection density at the cell's pressure, mdot (cp T_inject + u^2/2), and
+    unburnt gas -- exactly, whatever burns beside it."""
+    s, U, mdot = _injector_block()
+    gas = s.cfg
+    Fi, _ = s._inviscid_face_fluxes(s.ghost(U, thermal=False))
+    F = Fi[0] / s.block.a_i[0][:, None]
+    p = thermo.pressure_from_cons(U[0], gas.gamma)
+    u = mdot / (p / (gas.R * 900.0))
+    np.testing.assert_allclose(F[:, 0], mdot, rtol=1e-14)
+    np.testing.assert_allclose(F[:, 1], mdot * u + p, rtol=1e-14)
+    np.testing.assert_array_equal(F[:, 2], 0.0)
+    np.testing.assert_allclose(F[:, 3], mdot * (gas.cp * 900.0 + 0.5 * u * u), rtol=1e-14)
+    np.testing.assert_array_equal(F[:, 4], 0.0)
+    # and it is what the residual differences: the first column's mass rate
+    # is the declared inflow minus the Riemann flux through its downstream face
+    r = s._inviscid_residual(s.ghost(U, thermal=False))
+    vol = s.block.vol[0]
+    np.testing.assert_allclose(r[0, :, 0] * vol, Fi[0, :, 0] - Fi[1, :, 0], rtol=1e-12)
+
