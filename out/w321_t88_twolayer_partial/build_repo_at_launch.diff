+    face fluxes differ by 3.1% of the mass flow with point interpolation and
+    3.1% with the overlap average alone -- and by 4e-5 with two layers."""
+    return np.stack([_hand_over(L, edges_src, edges_dst) for L in _face_layers(U, side)])
