+def test_W340_every_plane_seam_hands_over_by_overlap(episode):
+    """The coupler's own wiring: each receiving face's prescribed state has the
+    face integral of the cells it came from -- a|b and b|e both ways, d to g,
+    and the f|g hole both ways."""
+    ep = episode
+    rng = np.random.default_rng(7)
+    saved = {k: [U.copy() for U in v] for k, v in ep.U.items()}
+    try:
+        for k in ep.U:
+            ep.U[k] = [U * (1.0 + 0.1 * rng.random(U.shape[:2]))[..., None] for U in ep.U[k]]
+        ep._wire_engine()
+        ep._wire_external()
+
+        def integral(state, edges):
+            return (np.asarray(state)[..., :4] * np.abs(np.diff(edges))[:, None]).sum(0)
+
+        B = ep.blocks
+        Ua, Ub, Ue = ep.U["a"][0], ep.U["b"][0], ep.U["e"][0]
+        pairs = [   # (receiver's state, its face edges, source's layer d, source's face edges)
+            (ep.sol["b"][0].bcs["imin"].params["state"], gen._face_edges(B["b"][0], "imin"),
+             lambda d: Ua[-1 - d], gen._face_edges(B["a"][0], "imax")),
+            (ep.sol["a"][0].bcs["imax"].params["state"], gen._face_edges(B["a"][0], "imax"),
+             lambda d: Ub[d], gen._face_edges(B["b"][0], "imin")),
+            (ep.sol["e"][0].bcs["imin"].params["state"], gen._face_edges(B["e"][0], "imin"),
+             lambda d: Ub[-1 - d], gen._face_edges(B["b"][0], "imax")),
+            (ep.sol["b"][0].bcs["imax"].params["state"], gen._face_edges(B["b"][0], "imax"),
+             lambda d: Ue[d], gen._face_edges(B["e"][0], "imin")),
+        ]
+        for got, eg, src, es in pairs:
+            assert got.shape[0] == NG, "handed over two layers deep"
+            for d in range(NG):
+                np.testing.assert_allclose(integral(got[d], eg), integral(src(d), es), rtol=1e-13)
+        j0, j1 = ep.sol["g"][0]._hole
+        zg, zf = gen._face_edges(B["g"][0], "jmin"), gen._face_edges(B["f"][0], "jmin")
+        lo, _hi = ep.sol["g"][0].hole_state
+        f_lo = ep.sol["f"][0].bcs["jmin"].params["state"]
+        for d in range(NG):
+            # f|g, g's side: f's edge rows, on the shared node lines
+            back = gen._as_gas(lo[:, d], ep.air_cfg, ep.gas_cfg)
+            np.testing.assert_allclose(integral(back, zg), integral(ep.U["f"][0][:, d], zf), rtol=1e-12)
+            # f|g, f's side: g's cells outboard of the plume
+            got = gen._as_gas(f_lo[:, d], ep.gas_cfg, ep.air_cfg)
+            np.testing.assert_allclose(integral(got, zf), integral(ep.U["g"][0][:, j0 - 1 - d], zg),
+                                       rtol=1e-12)
+        # d to g: g's live inlet cells, which d covers completely
+        gb = B["g"][0]
+        live = ~gb.blanked[0]
+        yg = gen._face_edges(gb, "imin")
+        g_in = ep.sol["g"][0].bcs["imin"].params["state"]
+        for k, db in enumerate(B["d"]):
+            up = db.nodes[..., 1].mean() > 0
+            mid = 0.5 * (yg[:-1] + yg[1:])
+            sel = live & ((mid > 0) if up else (mid <= 0))
+            w = np.abs(np.diff(yg))
+            yd = gen._face_edges(db, "imax")
+            lo_, hi_ = min(yg[:-1][sel].min(), yg[1:][sel].min()), max(yg[:-1][sel].max(), yg[1:][sel].max())
+            # the part of d's outlet that g's live band covers on this side
+            ov = np.clip(np.minimum(np.maximum(yd[:-1], yd[1:]), hi_)
+                         - np.maximum(np.minimum(yd[:-1], yd[1:]), lo_), 0.0, None)
+            for d in range(NG):
+                np.testing.assert_allclose((g_in[d][sel] * w[sel][:, None]).sum(0),
+                                           (ep.U["d"][k][-1 - d] * ov[:, None]).sum(0), rtol=1e-12)
+    finally:
+        ep.U = saved
