+    if side == "imin":
+        return U[:n]
+    if side == "imax":
+        return U[::-1][:n]
+    if side == "jmin":
+        return np.swapaxes(U[:, :n], 0, 1)
+    return np.swapaxes(U[:, ::-1][:, :n], 0, 1)
+
