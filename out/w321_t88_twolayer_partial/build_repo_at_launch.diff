+    s._viscous_residual(s.ghost(U))
+    work = s.Fj[:, 0, 3] - _conduction(s)
+    assert np.all(np.abs(work) > 1e-3 * np.abs(_conduction(s))), work / _conduction(s)
+    np.testing.assert_array_equal(s.Fj[:, 0, 1], shear)
