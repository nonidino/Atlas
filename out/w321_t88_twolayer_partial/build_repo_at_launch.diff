+# ---------------------------------------------- W339: work at a stationary wall
+
+
+class _WallSpy(Compressible2D):
+    def _isothermal_wall_conduction(self, Fi, Fj, T, Qz, Qy, k):
+        super()._isothermal_wall_conduction(Fi, Fj, T, Qz, Qy, k)
+        self.Fj = Fj.copy()
+
+
+def _old_wall_energy(self, Fi, Fj, T, Qz, Qy, k):
+    """Before W339 (W301 alone): replace the face-averaged CONDUCTION with the
+    one-sided wall term, and keep everything else the average carried."""
+    blk = self.block
+    nz, ny = blk.shape
+    for side in ("jmin", "jmax"):
+        bc = self.bcs.get(side)
+        if bc is None or bc.kind != "wall_noslip" or "T_wall" not in bc.params:
+            continue
+        jc, jg, f = (NG, NG - 1, 0) if side == "jmin" else (ny + NG - 1, ny + NG, -1)
+        sl_c, sl_g = (slice(NG, nz + NG), jc), (slice(NG, nz + NG), jg)
+        n, a, vol = blk.n_j[:, f], blk.a_j[:, f], blk.vol[:, 0 if f == 0 else -1]
+        avg = 0.5 * ((Qz[sl_c] + Qz[sl_g]) * n[..., 0] + (Qy[sl_c] + Qy[sl_g]) * n[..., 1]) * a
+        T_i = T[sl_c]
+        T_w = np.broadcast_to(np.asarray(bc.params["T_wall"], dtype=float), T_i.shape)
+        dn = 0.5 * vol / np.maximum(a, 1e-30)
+        grad = (T_i - T_w) / dn if f == 0 else (T_w - T_i) / dn
+        Fj[:, f, 3] += k[sl_c] * grad * a - avg
+    self.Fj = Fj.copy()
+
+
+def _sheared_wall(T_wall=288.0):
+    """2500 K gas at 5 MPa in a sheared layer along a 288 K no-slip wall at
+    jmin; an adiabatic no-slip wall at jmax."""
+    nz, ny = 6, 4
+    z, y = np.linspace(0, 0.06, nz + 1), np.linspace(0, 0.03, ny + 1)
+    Z, Y = np.meshgrid(z, y, indexing="ij")
+    blk = Block("w", np.stack([Z, Y], -1), np.zeros((nz, ny), bool))
+    gas = GasConfig(gamma=1.22, R=361.0)
+    s = _WallSpy(blk, gas, bcs={"jmin": BC("wall_noslip", {"T_wall": np.full(nz, T_wall)}),
+                                "jmax": BC("wall_noslip"), "imin": BC("extrapolate"),
+                                "imax": BC("extrapolate")})
+    W = np.zeros((nz, ny, 4))
+    W[..., 0] = 5.0e6 / (gas.R * 2500.0)
+    W[..., 1] = 800.0 * np.linspace(0.3, 1.0, ny)[None, :]
+    W[..., 3] = 5.0e6
+    return s, thermo.prim_to_cons(W, gas.gamma)
+
+
+def _conduction(s, T_gas=2500.0, T_wall=288.0):
+    cfg, blk = s.cfg, s.block
+    mu = thermo.sutherland(T_gas, cfg.mu_ref, cfg.T_mu_ref, cfg.sutherland_S)
+    dn = 0.5 * blk.vol[:, 0] / blk.a_j[:, 0]
+    return mu * cfg.cp / cfg.Pr * (T_gas - T_wall) / dn * blk.a_j[:, 0]
+
+
+def test_W339_a_no_slip_wall_face_carries_conduction_and_no_work():
+    """The viscous energy flux through a no-slip face is the wall's conduction:
+    exactly the one-sided term at an isothermal wall, exactly zero at an
+    adiabatic one. The shear is not touched."""
+    s, U = _sheared_wall()
+    s._viscous_residual(s.ghost(U))
+    np.testing.assert_allclose(s.Fj[:, 0, 3], _conduction(s), rtol=1e-13)
+    np.testing.assert_array_equal(s.Fj[:, -1, 3], 0.0)
+    assert np.all(np.abs(s.Fj[:, 0, 1]) > 0.0), "the wall still takes shear"
+
