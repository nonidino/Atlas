+def test_W340_a_layered_prescribed_state_fills_the_ghosts_in_order():
+    """Layer 0 sits against the face on every side; a single state still fills
+    both layers."""
+    nz, ny = 4, 3
+    z, y = np.linspace(0, 0.04, nz + 1), np.linspace(0, 0.03, ny + 1)
+    Z, Y = np.meshgrid(z, y, indexing="ij")
+    s = Compressible2D(Block("g", np.stack([Z, Y], -1), np.zeros((nz, ny), bool)),
+                       GasConfig(gamma=1.4, R=287.0), bcs={})
+    U = thermo.prim_to_cons(np.tile([1.0, 10.0, 0.0, 1.0e5], (nz, ny, 1)), 1.4)
+    li = np.stack([U[0] * (1 + d) for d in range(NG)])               # [NG, ny, 4]
+    lj = np.stack([U[:, 0] * (1 + d) for d in range(NG)], axis=1)    # [nz, NG, 4]
+    s.bcs = {"imin": BC("prescribed", {"state": li}), "imax": BC("prescribed", {"state": li}),
+             "jmin": BC("prescribed", {"state": lj}), "jmax": BC("prescribed", {"state": lj[:, :1]})}
+    Ue = s.ghost(U)
+    for d in range(NG):
+        np.testing.assert_array_equal(Ue[NG - 1 - d, NG:ny + NG], li[d])      # imin
+        np.testing.assert_array_equal(Ue[nz + NG + d, NG:ny + NG], li[d])     # imax
+        np.testing.assert_array_equal(Ue[NG:nz + NG, NG - 1 - d], lj[:, d])   # jmin
+        np.testing.assert_array_equal(Ue[NG:nz + NG, ny + NG + d], lj[:, 0])  # jmax: one state
+
