+def test_W340_two_layers_make_the_seam_one_face():
+    """Handed over two layers deep, both halves of the cut channel compute the
+    whole channel's own flux through the cut, bit for bit: the seam is no
+    longer there. Handed one state repeated in both ghost layers -- the
+    neighbour's cell centre -- the two sides disagree about the mass crossing
+    by 2.8% here: the throat's 3% floor, with no lag and no grid mismatch in
+    it."""
+    whole, left, right, U = _split_channel()
+    UL, UR = U[:6], U[6:]
+    want = whole._inviscid_face_fluxes(whole.ghost(U))[0][6]
+    left.bcs["imax"] = BC("prescribed", {"state": gen._face_layers(UR, "imin")})
+    right.bcs["imin"] = BC("prescribed", {"state": gen._face_layers(UL, "imax")})
+    FL = left._inviscid_face_fluxes(left.ghost(UL))[0][-1]
+    FR = right._inviscid_face_fluxes(right.ghost(UR))[0][0]
+    np.testing.assert_array_equal(FL, want)
+    np.testing.assert_array_equal(FR, want)
+    # the diagnosis: one layer, the neighbour's face cell repeated
+    left.bcs["imax"] = BC("prescribed", {"state": UR[:1]})
+    right.bcs["imin"] = BC("prescribed", {"state": UL[-1:]})
+    FL = left._inviscid_face_fluxes(left.ghost(UL))[0][-1]
+    FR = right._inviscid_face_fluxes(right.ghost(UR))[0][0]
+    created = (FR[:, 0] - FL[:, 0]).sum() / want[:, 0].sum()
+    assert abs(created) > 1e-2, created
+
