+def _hand_over(values, edges_src, edges_dst) -> np.ndarray:
+    """A plane seam's handover: each destination face cell gets the
+    overlap-weighted average of the source cells' CONSERVED states on the two
+    faces' node edges (`_cell_average`), so the face integral of every
+    conserved quantity crosses the seam unchanged. A destination cell no source
+    cell overlaps takes the nearest source cell. Either edge array may run in
+    either direction.
+
+    W340. Plane seams between non-matching grids were handed over by
+    `_remap`, point interpolation at the cell centroids, which preserves no
+    integral. An average of states does not make the two sides' fluxes equal
+    -- each side still computes its own -- but it hands over what the source
+    holds. It was written for the rocket's throat, where 3% of the mass flow
+    vanished every step, and it did not remove that: the floor was the ghost's
+    depth, not the interpolation (`_hand_over_layers`)."""
+    es = np.asarray(edges_src, dtype=float)
+    ed = np.asarray(edges_dst, dtype=float)
+    v = np.asarray(values, dtype=float)
+    if es[-1] < es[0]:
+        es, v = es[::-1], v[::-1]
+    flip = ed[-1] < ed[0]
+    if flip:
+        ed = ed[::-1]
+    avg, cov = _cell_average(v, es, ed)
+    empty = cov <= 0.0
+    if empty.any():
+        cs = 0.5 * (es[:-1] + es[1:])
+        cd = 0.5 * (ed[:-1] + ed[1:])[empty]
+        avg[empty] = v[np.abs(cs[None, :] - cd[:, None]).argmin(axis=1)]
+    return avg[::-1] if flip else avg
+
