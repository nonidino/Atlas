+    W[..., 3] = 6.0e6 - 4.0e6 * s ** 2
+    U = thermo.prim_to_cons(W, gas.gamma)
+    walls = {"jmin": BC("wall_slip"), "jmax": BC("wall_slip")}
+    whole = Compressible2D(Block("whole", nodes, np.zeros((nz, ny), bool)), gas,
