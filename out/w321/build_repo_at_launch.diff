+    #: W343 (2026-09-26): d-g is a two-way seam. `d`'s outlet takes `g`'s cells
+    #: where `g`'s live cells lie across it, and `g`'s inlet takes two layers of
+    #: `d`. False restores the one-way seam (d an outflow, g handed one layer),
+    #: which lost 2-4% of the seam's mass flow: beside the plume `g`'s first
+    #: cells are subsonic, and `d`, behind an outflow boundary, could not hear
+    #: them. The attribute is the control's switch.
+    D_G_TWO_WAY = True
+
+    def _d_outlet_layers(self, y_edges: np.ndarray) -> np.ndarray:
+        """`d`'s first NG cell layers in from its outlet plane, handed over onto
+        receiving cells with node edges ``y_edges``, in air: [NG, n_cells, 4],
+        layer 0 against the plane (the two-way d-g seam, W343)."""
+        y_edges = np.asarray(y_edges, dtype=float)
+        mid = 0.5 * (y_edges[:-1] + y_edges[1:])
+        out = np.empty((NG, mid.size, 4))
+        for k, blk in enumerate(self.blocks["d"]):
+            sel = (mid > 0) if blk.nodes[..., 1].mean() > 0 else (mid <= 0)
+            if sel.any():
+                st = _hand_over_layers(self.U["d"][k], "imax", _face_edges(blk, "imax"), y_edges)
+                out[:, sel] = st[:, sel]
+        return out
+
+    def _g_at_d_outlet(self, k: int):
+        """(`g`'s first NG live cell layers handed onto `d` panel k's outlet
+        cells, [NG, n, 4]; the mask of those cells that `g` couples to). A `d`
+        cell is coupled when at least half of its outlet face lies on `g`'s side
+        of the plume half-width; `d` has no node line there, and the cell that
+        straddles it stays an outflow."""
+        gb, db = self.blocks["g"][0], self.blocks["d"][k]
+        yg, yd = _face_edges(gb, "imin"), _face_edges(db, "imax")
+        mid = 0.5 * (yg[:-1] + yg[1:])
+        up = db.nodes[..., 1].mean() > 0
+        sel = ~gb.blanked[0] & ((mid > 0) if up else (mid <= 0))
+        j = np.flatnonzero(sel)
+        if j.size == 0 or np.any(np.diff(j) != 1):
+            raise AssertionError("g's live inlet cells on one side must be contiguous")
+        edges = np.concatenate([yg[j], yg[j[-1] + 1:j[-1] + 2]])
+        state = np.stack([_hand_over(self.U["g"][0][d, sel], edges, yd) for d in range(NG)])
+        lo = np.minimum(np.abs(yd[:-1]), np.abs(yd[1:]))
+        hi = np.maximum(np.abs(yd[:-1]), np.abs(yd[1:]))
+        hp = self.geo.plume_halfwidth
+        frac = np.clip((hi - np.maximum(lo, hp)) / np.maximum(hi - lo, 1e-300), 0.0, 1.0)
+        return state, frac >= 0.5
+
