+# ------------------------------------- W343: the d-g seam made two-way
+
+
+def test_W343_a_coupled_outflow_takes_the_neighbour_where_masked():
+    """An outflow face with `coupled_state` and `coupled_mask`: the masked
+    stations' ghosts are the given layers (layer 0 against the face), the
+    others the outflow's own extrapolation."""
+    whole, left, right, U = _split_channel()
+    UL, UR = U[:6], U[6:]
+    ny = UL.shape[1]
+    m = np.arange(ny) >= 2
+    lay = gen._face_layers(UR, "imin")
+    left.bcs["imax"] = BC("outflow", {"coupled_state": lay, "coupled_mask": m})
+    Ue = left.ghost(UL)
+    nz = UL.shape[0]
+    for d in range(NG):
+        np.testing.assert_array_equal(Ue[nz + NG + d, NG:ny + NG][m], lay[d][m])
+        np.testing.assert_array_equal(Ue[nz + NG + d, NG:ny + NG][~m], UL[-1][~m])
+
+
+def test_W343_a_two_way_seam_is_one_face_where_its_grids_match():
+    """Both sides handed the other's first two layers -- the outflow side
+    through `coupled_state` -- and each computes the uncut channel's flux
+    through the cut, bit for bit, in a subsonic stream. The control: the old
+    one-way seam (a plain outflow feeding two layers downstream) disagrees."""
+    whole, left, right, U = _split_channel()
+    UL, UR = U[:6], U[6:]
+    ny = UL.shape[1]
+    want = whole._inviscid_face_fluxes(whole.ghost(U))[0][6]
+    left.bcs["imax"] = BC("outflow", {"coupled_state": gen._face_layers(UR, "imin"),
+                                      "coupled_mask": np.ones(ny, bool)})
+    right.bcs["imin"] = BC("prescribed", {"state": gen._face_layers(UL, "imax")})
+    FL = left._inviscid_face_fluxes(left.ghost(UL))[0][-1]
+    FR = right._inviscid_face_fluxes(right.ghost(UR))[0][0]
+    np.testing.assert_array_equal(FL, want)
+    np.testing.assert_array_equal(FR, want)
+    left.bcs["imax"] = BC("outflow")
+    FL = left._inviscid_face_fluxes(left.ghost(UL))[0][-1]
+    assert abs((FR[:, 0] - FL[:, 0]).sum() / want[:, 0].sum()) > 1e-3
+
+
+def test_W343_d_takes_g_where_g_lies_across_its_outlet(episode):
+    """The coupler: d's outlet is coupled at exactly the cells at least half on
+    g's side of the plume half-width, with g's own live cells there, layer by
+    layer; and switching D_G_TWO_WAY off restores the one-way seam."""
+    ep = episode
+    rng = np.random.default_rng(11)
+    saved = {k: [U.copy() for U in v] for k, v in ep.U.items()}
+    try:
+        for k in ep.U:
+            ep.U[k] = [U * (1.0 + 0.1 * rng.random(U.shape[:2]))[..., None] for U in ep.U[k]]
+        ep._wire_external()
+        gb = ep.blocks["g"][0]
+        yg = gen._face_edges(gb, "imin")
+        hp = ep.geo.plume_halfwidth
+        for k, db in enumerate(ep.blocks["d"]):
+            p = ep.sol["d"][k].bcs["imax"].params
+            yd = gen._face_edges(db, "imax")
+            lo = np.minimum(np.abs(yd[:-1]), np.abs(yd[1:]))
+            hi = np.maximum(np.abs(yd[:-1]), np.abs(yd[1:]))
+            frac = np.clip((hi - np.maximum(lo, hp)) / (hi - lo), 0.0, 1.0)
+            np.testing.assert_array_equal(p["coupled_mask"], frac >= 0.5)
+            assert p["coupled_mask"].any() and not p["coupled_mask"].all()
+            # d's cells entirely on g's side hold g's layer averages exactly
+            full = frac >= 1.0
+            up = db.nodes[..., 1].mean() > 0
+            mid = 0.5 * (yg[:-1] + yg[1:])
+            sel = ~gb.blanked[0] & ((mid > 0) if up else (mid <= 0))
+            for j in np.flatnonzero(full):
+                a0, a1 = sorted((yd[j], yd[j + 1]))
+                w = np.array([max(0.0, min(a1, max(yg[i], yg[i + 1])) - max(a0, min(yg[i], yg[i + 1])))
+                              if sel[i] else 0.0 for i in range(yg.size - 1)])
+                for d in range(NG):
+                    want = (ep.U["g"][0][d] * w[:, None]).sum(0) / w.sum()
+                    np.testing.assert_allclose(p["coupled_state"][d][j], want, rtol=1e-12)
+        assert ep.sol["g"][0].bcs["imin"].params["state"].shape[0] == NG
+        # the control's switch: the one-way seam of W340
+        gen.CoupledEpisode.D_G_TWO_WAY = False
+        ep._wire_external()
+        for k in range(len(ep.blocks["d"])):
+            assert "coupled_state" not in ep.sol["d"][k].bcs["imax"].params
+        assert ep.sol["g"][0].bcs["imin"].params["state"].shape[0] == 1
+    finally:
+        gen.CoupledEpisode.D_G_TWO_WAY = True
+        ep.U = saved
