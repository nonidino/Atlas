+def _cell_average(values, edges_src, edges_dst):
+    """Overlap-weighted average of cell values onto destination intervals.
+
+    Returns ``(avg, covered)``: the average over the part of each destination
+    interval that some source cell overlaps, and that part as a fraction of the
+    interval. Integrals are preserved: sum(avg * covered * width_dst) equals the
+    overlapped part of sum(values * width_src)."""
+    es = np.asarray(edges_src, dtype=float)
+    ed = np.asarray(edges_dst, dtype=float)
+    lo = np.maximum(es[None, :-1], ed[:-1, None])
+    hi = np.minimum(es[None, 1:], ed[1:, None])
+    w = np.clip(hi - lo, 0.0, None)                      # [n_dst, n_src]
+    tot = w.sum(axis=1)
+    v = np.asarray(values, dtype=float)
+    flat = v.reshape(v.shape[0], -1)
+    avg = (w @ flat) / np.maximum(tot, 1e-300)[:, None]
+    return avg.reshape((ed.size - 1,) + v.shape[1:]), tot / np.diff(ed)
