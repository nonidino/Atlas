+def segment_counts(lengths, n: int) -> np.ndarray:
+    """Cells per segment: proportional to length, at least one each, summing to n.
+
+    Largest-remainder rounding, so the split is deterministic and a segment's
+    share never differs from its proportional share by a whole cell."""
+    lengths = np.asarray(lengths, dtype=np.float64)
+    if n < lengths.size:
+        raise ValueError(f"{n} cells cannot give each of {lengths.size} segments one")
+    q = n * lengths / lengths.sum()
+    c = np.maximum(1, np.floor(q)).astype(int)
+    while c.sum() < n:
+        c[int(np.argmax(q - c))] += 1
+    while c.sum() > n:
