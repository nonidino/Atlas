+def _as_gas(U: np.ndarray, src: GasConfig, dst: GasConfig) -> np.ndarray:
+    """A conserved state of one gas, re-expressed for a block that runs another.
+
+    Pressure, temperature and velocity are what is continuous across a contact
+    between two gases, so those are kept and the density follows the receiver's
+    R. Handing the conserved vector across unchanged keeps rho and E instead,
+    and the receiver then reads p' = (g'-1)/(g-1) p and T' = p'/(rho R'): air
+    read by the plume's gas model came out at 0.437 T and 0.550 p, and plume gas
+    read as air at 2.287 T and 1.818 p."""
+    if src.gamma == dst.gamma and src.R == dst.R:
+        return U
+    W = thermo.cons_to_prim(U, src.gamma)
+    T = W[..., 3] / (np.maximum(W[..., 0], thermo.RHO_FLOOR) * src.R)
+    W = W.copy()
+    W[..., 0] = W[..., 3] / (dst.R * np.maximum(T, 1.0))
+    return thermo.prim_to_cons(W, dst.gamma)
+
